---
import { personSlug, formatPts, labelOf } from '../lib/data.ts'
import type { ChampInfo } from '../lib/types.ts'

interface Props {
  label: string
  person: ChampInfo
  year?: string
  tone?: 'champ' | 'last'
  labels?: Map<string, string>
}
const { label, person, year, tone = 'champ', labels = new Map() } = Astro.props
const name = labelOf(person.first_l, labels)
---
<article class:list={['card', { accent: tone === 'champ' }]}>
  <div class:list={['card-label', { danger: tone === 'last' }]}>{label}{year ? ` · ${year}` : ''}</div>
  <div class="big-name">
    <a href={`/managers/${personSlug(person.first_l)}`}>{name}</a>
  </div>
  <div class="meta">{person.team_name}</div>
  <div class="meta">{person.record} · {formatPts(person.fpts)} PF</div>
</article>
