---
import BaseLayout from '../layout/BaseLayout.astro'
import ChampCard from '../components/ChampCard.astro'
import StandingsTable from '../components/StandingsTable.astro'
import TopScorers from '../components/TopScorers.astro'
import { loadSummary, weeklyMatchups, formatPts, labelsForSummary, labelOf, loadTopScorers } from '../lib/data.ts'
import type { SiteConfig } from '../lib/types.ts'
import { seasonDivisions } from '../lib/manager-stats.ts'

interface Props {
  config: SiteConfig
  year: string
}
const { config, year } = Astro.props
const summary = loadSummary(config.leagueKey)
const labels = labelsForSummary(summary)
const season = summary.seasons.find((s) => s.season === year)
if (!season) throw new Error(`Unknown season ${year} for ${config.leagueKey}`)
const weeks = weeklyMatchups(config.leagueKey, year)
const div = seasonDivisions(config.leagueKey, season)
const topScorers = loadTopScorers(config.leagueKey, year)
const allYears = summary.seasons.map((s) => s.season).sort((a, b) => Number(b) - Number(a))
---
<BaseLayout
  title={`${year} season`}
  leagueName={config.leagueName}
  accent={config.accent}
  path={`/seasons/${year}`}
>
  <div class="hero">
    <div class="eyebrow">{season.league_name}</div>
    <div class="season-title">
      <h1>{year}</h1>
      <label class="season-jump">
        <span class="sr-only">Jump to season</span>
        <select id="season-jump" class="h2h-select season-select" aria-label="Jump to season">
          {allYears.map((y) => <option value={`/seasons/${y}`} selected={y === year}>{y}</option>)}
        </select>
      </label>
      <noscript>
        <style>{'.season-jump{display:none}'}</style>
        <nav class="season-jump-links" aria-label="Other seasons">
          {allYears.map((y, i) => <>{i > 0 && ' · '}{y === year ? <strong>{y}</strong> : <a href={`/seasons/${y}`}>{y}</a>}</>)}
        </nav>
      </noscript>
    </div>
    <p class="lede">{season.total_rosters} teams · playoff places and regular-season point leaders · weekly H2H below.</p>
    {season.note && <p class="note">{season.note}</p>}
    {season.source === 'yahoo' && <p class="note">Played on Yahoo Fantasy.</p>}
  </div>
  <div class="grid cols-2">
    <ChampCard label="Champion" person={season.champion} year={year} labels={labels} />
    <ChampCard label="Last place" person={season.last_place} year={year} tone="last" labels={labels} />
  </div>
  <section class="section">
    <h2>Standings</h2>
    <StandingsTable season={season} labels={labels} div={div} />
  </section>
  {topScorers && <TopScorers data={topScorers} labels={labels} />}
  <section class="section">
    <h2>Weekly matchups</h2>
    <p class="note">Regular season and playoffs. Winner highlighted.</p>
    <div class="week-stack">
      {weeks.filter(({ matchups }) => matchups.length).map(({ week, matchups }) => (
        <div class="week-block" id={`week-${parseInt(week)}`}>
          <h3 class="week-title">Week {week}</h3>
          <div class="matchup-list">
            {matchups.map((m) => {
              const aWin = m.b && m.a.points > m.b.points
              const bWin = m.b && m.b.points > m.a.points
              return (
                <div class="matchup-row">
                  <div class:list={["side", { winner: !!aWin }]}>
                    <div class="who">{labelOf(m.a.first_l, labels)}</div>
                    <div class="team">{m.a.team_name}</div>
                    <div class="pts">{formatPts(m.a.points)}</div>
                  </div>
                  <div class="vs">vs</div>
                  {m.b ? (
                    <div class:list={["side", { winner: !!bWin }]}>
                      <div class="who">{labelOf(m.b.first_l, labels)}</div>
                      <div class="team">{m.b.team_name}</div>
                      <div class="pts">{formatPts(m.b.points)}</div>
                    </div>
                  ) : (
                    <div class="side"><div class="who">Bye</div></div>
                  )}
                </div>
              )
            })}
          </div>
        </div>
      ))}
    </div>
  </section>
  <script is:inline>
    (function () {
      var sel = document.getElementById('season-jump')
      if (!sel) return
      sel.addEventListener('change', function () { if (sel.value) location.href = sel.value })
      // Restore the current season if the page comes back from the back/forward cache.
      window.addEventListener('pageshow', function () {
        var cur = sel.querySelector('option[selected]')
        if (cur) sel.value = cur.value
      })
    })()
  </script>
</BaseLayout>
