---
import BaseLayout from '../layout/BaseLayout.astro'
import { loadSummary, managersFromSummary, labelsForSummary, labelOf } from '../lib/data.ts'
import type { SiteConfig } from '../lib/types.ts'

interface Props {
  config: SiteConfig
}
const { config } = Astro.props
const summary = loadSummary(config.leagueKey)
const labels = labelsForSummary(summary)
const managers = managersFromSummary(summary)
---
<BaseLayout title="Managers" leagueName={config.leagueName} accent={config.accent} path="/managers">
  <div class="hero">
    <div class="eyebrow">{config.leagueName}</div>
    <h1>Managers</h1>
    <p class="lede">First name when unique; initials only when needed to avoid collisions.</p>
  </div>
  <div class="table-wrap">
    <table class="standings">
      <thead>
        <tr>
          <th>Manager</th>
          <th>Seasons</th>
          <th>Titles</th>
          <th>Latest team</th>
        </tr>
      </thead>
      <tbody>
        {managers.map((m) => {
          const latest = m.seasons[0]
          return (
            <tr>
              <td><a href={`/managers/${m.slug}`}>{labelOf(m.first_l, labels)}</a></td>
              <td>{m.seasons.map((s) => s.season).join(', ')}</td>
              <td>{m.titles.length ? m.titles.join(', ') : '—'}</td>
              <td>{latest?.team_name ?? '—'}</td>
            </tr>
          )
        })}
      </tbody>
    </table>
  </div>
  <p class="note">{managers.length} managers in completed {config.leagueName} seasons.</p>
</BaseLayout>
