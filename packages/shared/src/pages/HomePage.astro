---
import BaseLayout from '../layout/BaseLayout.astro'
import { loadSummary, formatPts, labelsForSummary, labelOf, personSlug } from '../lib/data.ts'
import type { SiteConfig } from '../lib/types.ts'

interface Props {
  config: SiteConfig
}
const { config } = Astro.props
const summary = loadSummary(config.leagueKey)
const labels = labelsForSummary(summary)
const years = summary.seasons.map((s) => s.season).join(', ')
const seasons = [...summary.seasons].sort((a, b) => Number(b.season) - Number(a.season))

type Person = { first_l: string; team_name: string; points?: number } | null | undefined
---
<BaseLayout
  title={`${config.fullName} history`}
  leagueName={config.leagueName}
  accent={config.accent}
  path="/"
  description={`${config.fullName} completed-season archive.`}
>
  <div class="hero">
    <div class="eyebrow">Completed seasons · {years}</div>
    <h1>{config.fullName}</h1>
    <p class="lede">{config.tagline}</p>
  </div>

  <section class="year-stack">
    {seasons.map((s) => {
      const p = s.placements
      const rows: { label: string; person: Person; pts?: boolean }[] = [
        { label: '1st', person: p?.first },
        { label: '2nd', person: p?.second },
        { label: '3rd', person: p?.third },
        { label: 'Regular season high points', person: p?.high_points, pts: true },
        { label: 'Regular season low points', person: p?.low_points, pts: true },
      ]
      return (
        <div class="year-block">
          <a class="year-head" href={`/seasons/${s.season}`}>
            <h2>{s.season}</h2>
            <span class="year-cta">Season view · weekly matchups →</span>
          </a>
          <ul class="year-stats">
            {rows.map(({ label, person, pts }) => (
              <li>
                <span class="stat-label">{label}</span>
                <span class="stat-value">
                  {person ? (
                    <>
                      <a class="owner-link" href={`/managers/${personSlug(person.first_l)}`}>
                        {labelOf(person.first_l, labels)}
                      </a>
                      <span class="stat-rest">
                        {' · '}
                        {person.team_name}
                        {pts && person.points != null ? ` · ${formatPts(person.points)}` : ''}
                      </span>
                    </>
                  ) : (
                    '—'
                  )}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )
    })}
  </section>

  <section class="section">
    <div class="grid cols-2">
      <a class="card" href="/seasons">
        <div class="card-label">Browse</div>
        <h3>All seasons</h3>
        <p class="meta">Standings and week-by-week matchups.</p>
      </a>
      <a class="card" href="/managers">
        <div class="card-label">Browse</div>
        <h3>Managers</h3>
        <p class="meta">Names shorten automatically when there’s no conflict.</p>
      </a>
    </div>
  </section>
</BaseLayout>
