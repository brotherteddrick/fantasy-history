---
import BaseLayout from '../layout/BaseLayout.astro'
import { loadSummary, formatPts, labelsForSummary, labelOf } from '../lib/data.ts'
import type { SiteConfig } from '../lib/types.ts'

interface Props {
  config: SiteConfig
}
const { config } = Astro.props
const summary = loadSummary(config.leagueKey)
const labels = labelsForSummary(summary)
const years = summary.seasons.map((s) => s.season).join(', ')
const seasons = [...summary.seasons].sort((a, b) => Number(b.season) - Number(a.season))

function line(person: { first_l: string; team_name: string; points?: number } | null | undefined, pts = false) {
  if (!person) return '—'
  const name = labelOf(person.first_l, labels)
  const ptsBit = pts && person.points != null ? ` · ${formatPts(person.points)}` : ''
  return `${name} · ${person.team_name}${ptsBit}`
}
---
<BaseLayout
  title={`${config.fullName} history`}
  leagueName={config.leagueName}
  accent={config.accent}
  path="/"
  description={`${config.fullName} completed-season archive.`}
>
  <div class="hero">
    <div class="eyebrow">Completed seasons · {years}</div>
    <h1>{config.fullName}</h1>
    <p class="lede">{config.tagline}</p>
  </div>

  <section class="year-stack">
    {seasons.map((s) => {
      const p = s.placements
      return (
        <a class="year-block" href={`/seasons/${s.season}`}>
          <div class="year-head">
            <h2>{s.season}</h2>
            <span class="year-cta">Season view · weekly matchups →</span>
          </div>
          <ul class="year-stats">
            <li><span class="stat-label">1st</span><span class="stat-value">{line(p?.first)}</span></li>
            <li><span class="stat-label">2nd</span><span class="stat-value">{line(p?.second)}</span></li>
            <li><span class="stat-label">3rd</span><span class="stat-value">{line(p?.third)}</span></li>
            <li><span class="stat-label">Regular season high points</span><span class="stat-value">{line(p?.high_points, true)}</span></li>
            <li><span class="stat-label">Regular season low points</span><span class="stat-value">{line(p?.low_points, true)}</span></li>
          </ul>
        </a>
      )
    })}
  </section>

  <section class="section">
    <div class="grid cols-2">
      <a class="card" href="/seasons">
        <div class="card-label">Browse</div>
        <h3>All seasons</h3>
        <p class="meta">Standings and week-by-week matchups.</p>
      </a>
      <a class="card" href="/managers">
        <div class="card-label">Browse</div>
        <h3>Managers</h3>
        <p class="meta">Names shorten automatically when there’s no conflict.</p>
      </a>
    </div>
  </section>
</BaseLayout>
